#!/usr/bin/env bash
set -euo pipefail

# Runbook compliance pre-commit hook
# Uses scripts/check_runbooks.py

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Collect staged files
CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)

python3 scripts/check_runbooks.py --root "$ROOT" --mode changed --changed-files "$CHANGED"
